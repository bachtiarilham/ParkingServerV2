package laporan

import (
	dto "modulegue/internal/data/mobile/remote/dto/laporan"
	model "modulegue/internal/domain/mobile/model/laporan"
)

func ToLaporanDto(src *model.LaporanModel) *dto.LaporanResponseDto {
	if src == nil {
		return nil
	}

	var items []dto.LaporanItem
	if src.PendapatanPerTanggal != nil {
		items = make([]dto.LaporanItem, 0, len(*src.PendapatanPerTanggal))
		for _, item := range *src.PendapatanPerTanggal {
			items = append(items, dto.LaporanItem{
				Tanggal:              item.Tanggal,
				TotalTransaksi:       item.TotalTransaksi,
				TotalPendapatanJukir: item.TotalPendapatanJukir,
				MotorCount:           item.MotorCount,
				CarCount:             item.CarCount,
				QrisCount:            item.QrisCount,
				CashCount:            item.CashCount,
			})
		}
	}

	return &dto.LaporanResponseDto{
		TanggalAwal:          src.TanggalAwal,
		TanggalAkhir:         src.TanggalAkhir,
		TotalTransaksi:       src.TotalTransaksi,
		TotalPendapatanJukir: src.TotalPendapatanJukir,
		PendapatanPerTanggal: &items,
	}
}
