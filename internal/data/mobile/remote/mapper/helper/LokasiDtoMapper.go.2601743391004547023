package helper

import (
	dto "modulegue/internal/data/mobile/remote/dto/helper"
	model "modulegue/internal/domain/mobile/model/helper"
)

func ToLokasiDto(src *model.LokasiModel) *dto.LokasiResponseDto {
	if src == nil {
		return nil
	}
	items := make([]dto.LokasiItemResponseDto, 0)
	if src.LokasiItem != nil {
		items = make([]dto.LokasiItemResponseDto, 0, len(*src.LokasiItem))
		for _, item := range *src.LokasiItem {
			items = append(items, dto.LokasiItemResponseDto{
				NamaLokasi: item.NamaLokasi,
				LokasiId:   item.LokasiId,
				AreaId:     item.AreaId,
				NamaArea:   item.NamaArea,
				ZonaId:     item.ZonaId,
				NamaZona:   item.NamaZona,
				Address:    item.Address,
			})
		}
	}

	return &dto.LokasiResponseDto{
		LokasiItem: &items,
	}
}
